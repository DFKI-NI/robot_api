<?xml version="1.0"?>
<package format="3">
  <name>robot_api_msgs</name>
  <version>1.12.0</version>
  <description>Robot api messages</description>

  <maintainer email="Alexander.Sung@dfki.de">Alexander Sung</maintainer>
  <license>MIT</license>
  <url type="website">https://git.ni.dfki.de/acting/robot_api</url>
  <author email="Alexander.Sung@dfki.de">Alexander Sung</author>

  <build_export_depend>geometry_msgs</build_export_depend>

  <build_depend>geometry_msgs</build_depend>
  <build_depend condition="$ROS_VERSION == 1">message_generation</build_depend>
  <build_depend condition="$ROS_VERSION == 2">rosidl_default_generators</build_depend>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>

  <exec_depend condition="$ROS_VERSION == 1">message_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>
</package>
